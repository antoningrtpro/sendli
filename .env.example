# Propaly Environment Variables
# Copy this file to .env and fill in your values

# Database (SQLite for local dev — swap to libsql:// or postgres:// for production)
DATABASE_URL="file:./prisma/dev.db"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Uploadthing — get your token at uploadthing.com
UPLOADTHING_TOKEN="your-uploadthing-token"

# App URL (used for PDF rendering)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
