// Propaly - Commercial Proposal Platform

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  plan          String    @default("free")
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  brandKit     BrandKit?
  proposals    Proposal[]
  banners      Banner[]
  testimonials Testimonial[]
  useCases     UseCase[]
  caseStudies  CaseStudy[]
  savedBlocks  SavedBlock[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BrandKit {
  id             String   @id @default(cuid())
  userId         String   @unique
  logoUrl        String?
  primaryColor   String   @default("#111184")
  secondaryColor String   @default("#1a1ab8")
  fontFamily     String   @default("Inter")
  bgColor        String   @default("#ffffff")
  textColor      String   @default("#1f2937")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Reusable banners — shown at top of each proposal
model Banner {
  id          String   @id @default(cuid())
  userId      String
  name        String   @default("New Banner")
  bgColor     String   @default("#111184")
  bgImageUrl  String?
  title       String   @default("")
  subtitle    String   @default("")
  textColor   String   @default("#ffffff")
  logoUrl     String?
  imageOnly   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposals Proposal[]
}

// Reusable testimonials library
model Testimonial {
  id        String   @id @default(cuid())
  userId    String
  quote     String
  author    String
  role      String   @default("")
  company   String   @default("")
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Reusable use cases library
model UseCase {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  icon        String   @default("✅")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Reusable case studies library
model CaseStudy {
  id             String   @id @default(cuid())
  userId         String
  title          String
  tags           String   @default("[]")  // JSON array of strings
  description    String   @default("")
  quote          String?
  authorName     String?
  authorRole     String?
  authorAvatarUrl String?
  linkLabel      String?
  linkUrl        String?
  mediaUrl       String?
  metrics        String   @default("[]")  // JSON array of CaseStudyMetric
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Proposals
model Proposal {
  id             String   @id @default(cuid())
  userId         String
  bannerId       String?
  title          String   @default("Untitled Proposal")
  slug           String   @unique
  published      Boolean  @default(false)
  blocks         String   @default("[]")
  status         String   @default("pending")  // "pending" | "won" | "lost"
  amountOneShot  Float?                         // montant one shot (€)
  amountMrr      Float?                         // MRR mensuel (€)
  clientLogoUrl  String?                        // logo du client (affiché dans le header public)
  password       String?                        // bcrypt hash — accès protégé
  showPdfButton  Boolean  @default(true)        // afficher le bouton PDF dans le header public
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  banner Banner?         @relation(fields: [bannerId], references: [id], onDelete: SetNull)
  events ProposalEvent[]
  links  ProposalLink[]
}

model ProposalEvent {
  id              String   @id @default(cuid())
  proposalId      String
  linkId          String?
  eventType       String
  blockId         String?
  visitorHash     String?
  durationSeconds Int?
  metadata        String?
  createdAt       DateTime @default(now())

  proposal Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  link     ProposalLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([proposalId, eventType])
  @@index([proposalId, createdAt])
  @@index([proposalId, visitorHash])
  @@index([linkId])
}

// Per-recipient tracking links
model ProposalLink {
  id             String   @id @default(cuid())
  proposalId     String
  token          String   @unique  // random token used in URL ?lid=TOKEN
  recipientEmail String?
  recipientName  String?
  createdAt      DateTime @default(now())

  proposal Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  events   ProposalEvent[]

  @@index([proposalId])
}

// Reusable saved blocks (favorites)
model SavedBlock {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Bloc sans nom")
  blockType String                           // heading, text, pricing, etc.
  data      String                           // JSON – full block or design-only
  mode      String   @default("template")    // "ultra" | "template"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mode])
}
